#!/bin/bash
#SBATCH -t 02:00:00
#SBATCH -A ast236
#SBATCH -N 1
#SBATCH -p batch
#SBATCH -J kangaroo-temp-density
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32

set -euo pipefail

REPO_ROOT="${KANGAROO_REPO_ROOT:-${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}}"
source "$REPO_ROOT/batch/runtime.sh"
kangaroo_setup_runtime

export KANGAROO_EXECUTOR_MODE="${KANGAROO_EXECUTOR_MODE:-streaming}"
export KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY="${KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY:-128}"
export KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY="${KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY:-16G}"
export KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY="${KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY:-2G}"
export KANGAROO_PLOTFILE_READ_CONCURRENCY="${KANGAROO_PLOTFILE_READ_CONCURRENCY:-16}"
export KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT="${KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT:-16G}"
export KANGAROO_PLOTFILE_IO_POOL="${KANGAROO_PLOTFILE_IO_POOL:-plotfile_io}"
export KANGAROO_PLOTFILE_IO_POOL_THREADS="${KANGAROO_PLOTFILE_IO_POOL_THREADS:-16}"
if [[ "${KANGAROO_EVENT_LOG:-}" == "auto" || "${KANGAROO_EVENT_LOG:-}" == "1" ]]; then
  mkdir -p event_logs
  export KANGAROO_EVENT_LOG="$PWD/event_logs/temperature_density.${SLURM_JOB_ID:-manual}.events.jsonl"
fi
if [[ "${KANGAROO_PROGRESS:-0}" == "1" ]]; then
  set -- "$@" --progress
fi

kangaroo_launch "$REPO_ROOT/scripts/plotfile_temperature_density.py" -- \
  "$@" --output-json "${OUTPUT_JSON:-temperature_density_histogram.json}"
