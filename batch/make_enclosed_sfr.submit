#!/bin/bash
#SBATCH -t 00:30:00
#SBATCH -A ast236
#SBATCH -N 1
#SBATCH -p batch
#SBATCH -J kangaroo-enclosed-sfr
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=128

set -euo pipefail

# Initialize the module system if this batch shell did not inherit it
# (sbatch does not propagate exported shell functions or MODULEPATH
# reliably).
if ! type module >/dev/null 2>&1; then
  # shellcheck disable=SC1091
  source /sw/riker/lmod/lmod/init/bash
fi
: "${MODULEPATH:=/etc/scl/modulefiles:/sw/riker/spack/modules/gcc/14.2.0/mpich-5.0.1/gcc-14.2.0:/sw/riker/spack/modules/gcc/14.2.0/gcc-14.2.0:/sw/riker/spack/modules/Core/26.01:/sw/riker/modulefiles}"
export MODULEPATH
module load gcc/14.2.0

# Make the personal spack installation discoverable regardless of the
# submitting shell's PATH (needed for `spack location -i` below).
if ! command -v spack >/dev/null 2>&1; then
  export PATH="${HOME}/spack/bin:${PATH}"
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: sbatch $0 PLOTFILE" >&2
  exit 2
fi
PLOTFILE=$1
# Disk profile: SFR(R) within |z| <= DISK_HEIGHT_KPC.
: "${RMIN_KPC:=0.1}"
: "${RMAX_KPC:=30.0}"
: "${DISK_HEIGHT_KPC:=1.0}"
# Wind profile: SFR(h) within radius WIND_RADIUS_KPC.
: "${WIND_RADIUS_KPC:=5.0}"
: "${ZMIN_KPC:=0.1}"
: "${ZMAX_KPC:=30.0}"
: "${SFR_WINDOW_MYR:=10.0}"
: "${FIELD_KIND:=rate_density}"
: "${KANGAROO_FLUX_PROFILE:=production}"

case "$KANGAROO_FLUX_PROFILE" in
  production)
    : "${NBINS:=50}"
    : "${OUTPUT_JSON_DISK:=enclosed_sfr_disk.json}"
    : "${OUTPUT_JSON_WIND:=enclosed_sfr_wind.json}"
    : "${OUTPUT_JSON_JOINT:=enclosed_sfr_joint.json}"
    ;;
  diagnostic)
    : "${NBINS:=8}"
    : "${OUTPUT_JSON_DISK:=enclosed_sfr_disk.diagnostic.json}"
    : "${OUTPUT_JSON_WIND:=enclosed_sfr_wind.diagnostic.json}"
    : "${OUTPUT_JSON_JOINT:=enclosed_sfr_joint.diagnostic.json}"
    : "${KANGAROO_EVENT_LOG:=auto}"
    : "${KANGAROO_PROGRESS:=1}"
    ;;
  *)
    echo "Unsupported KANGAROO_FLUX_PROFILE='$KANGAROO_FLUX_PROFILE' (use production or diagnostic)" >&2
    exit 2
    ;;
esac

: "${KANGAROO_EXECUTOR_MODE:=streaming}"
: "${KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY:=128}"
: "${KANGAROO_PLOTFILE_READ_CONCURRENCY:=16}"
: "${KANGAROO_EXECUTOR_MAX_ACTIVE_STORAGE_UNITS_PER_LOCALITY:=64}"
: "${KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY:=64G}"
: "${KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY:=2G}"
: "${KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT:=64G}"
: "${KANGAROO_PLOTFILE_IO_POOL:=plotfile_io}"
: "${KANGAROO_PLOTFILE_IO_POOL_THREADS:=16}"
: "${KANGAROO_PLOTFILE_ZERO_COPY_READS:=1}"
export KANGAROO_EXECUTOR_MODE
export KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY
export KANGAROO_EXECUTOR_MAX_ACTIVE_STORAGE_UNITS_PER_LOCALITY
export KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY
export KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY
export KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT
export KANGAROO_PLOTFILE_READ_CONCURRENCY
export KANGAROO_PLOTFILE_IO_POOL
export KANGAROO_PLOTFILE_IO_POOL_THREADS
export KANGAROO_PLOTFILE_ZERO_COPY_READS

PROGRESS_ARGS=()
if [[ "${KANGAROO_PROGRESS:-0}" == "1" ]]; then
  PROGRESS_ARGS+=(--progress)
fi
if [[ -n "${KANGAROO_EVENT_LOG:-}" ]]; then
  mkdir -p event_logs
  if [[ "$KANGAROO_EVENT_LOG" == "1" || "$KANGAROO_EVENT_LOG" == "auto" ]]; then
    KANGAROO_EVENT_LOG="$PWD/event_logs/enclosed_sfr.${SLURM_JOB_ID:-manual}.events.jsonl"
  fi
  export KANGAROO_EVENT_LOG
fi

export PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1

export SPACK_HPX_PREFIX="$(spack location -i 'hpx@1.11.0 networking=mpi %gcc@14.2.0')"
export SPACK_MPI_PREFIX="$(spack location -i 'openmpi%gcc@14.2.0')"
export LD_LIBRARY_PATH="$SPACK_HPX_PREFIX/lib64:$SPACK_HPX_PREFIX/lib:$SPACK_MPI_PREFIX/lib64:$SPACK_MPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"

NNODES="${SLURM_NNODES:-1}"
CPUS_PER_TASK="${SLURM_CPUS_PER_TASK:-128}"
if [[ "${SLURM_TRES_PER_TASK:-}" =~ (^|,)cpu=([0-9]+)(,|$) ]]; then
  CPUS_PER_TASK="${BASH_REMATCH[2]}"
  if [[ "${SLURM_CPUS_PER_TASK:-}" != "$CPUS_PER_TASK" ]]; then
    echo "Normalizing SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK:-unset} to SLURM_TRES_PER_TASK cpu=${CPUS_PER_TASK}"
  fi
  export SLURM_CPUS_PER_TASK="$CPUS_PER_TASK"
fi

HPX_GUARD_PAGE_ARG=--hpx:ini=hpx.stacks.use_guard_pages=0
export HPXRUN_ARGS="${HPXRUN_ARGS:+${HPXRUN_ARGS} }${HPX_GUARD_PAGE_ARG}"

date
echo "host=$(hostname)"
echo "SLURM_JOB_ID=${SLURM_JOB_ID:-manual}"
echo "NNODES=${NNODES}"
echo "CPUS_PER_TASK=${CPUS_PER_TASK}"
echo "SPACK_HPX_PREFIX=${SPACK_HPX_PREFIX}"
echo "SPACK_MPI_PREFIX=${SPACK_MPI_PREFIX}"
echo "HPXRUN_ARGS=${HPXRUN_ARGS}"
echo "KANGAROO_FLUX_PROFILE=${KANGAROO_FLUX_PROFILE}"
echo "KANGAROO_EXECUTOR_MODE=${KANGAROO_EXECUTOR_MODE}"
echo "KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY=${KANGAROO_EXECUTOR_MAX_ACTIVE_TASKS_PER_LOCALITY}"
echo "KANGAROO_EXECUTOR_MAX_ACTIVE_STORAGE_UNITS_PER_LOCALITY=${KANGAROO_EXECUTOR_MAX_ACTIVE_STORAGE_UNITS_PER_LOCALITY}"
echo "KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY=${KANGAROO_EXECUTOR_MAX_INPUT_BYTES_PER_LOCALITY}"
echo "KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY=${KANGAROO_EXECUTOR_MAX_OUTPUT_BYTES_PER_LOCALITY}"
echo "KANGAROO_PLOTFILE_READ_CONCURRENCY=${KANGAROO_PLOTFILE_READ_CONCURRENCY}"
echo "KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT=${KANGAROO_PLOTFILE_READ_MAX_BYTES_IN_FLIGHT}"
echo "KANGAROO_PLOTFILE_IO_POOL=${KANGAROO_PLOTFILE_IO_POOL}"
echo "KANGAROO_PLOTFILE_IO_POOL_THREADS=${KANGAROO_PLOTFILE_IO_POOL_THREADS}"
echo "KANGAROO_PLOTFILE_ZERO_COPY_READS=${KANGAROO_PLOTFILE_ZERO_COPY_READS}"
echo "KANGAROO_EVENT_LOG=${KANGAROO_EVENT_LOG:-disabled}"
echo "plotfile=${PLOTFILE}"
echo "rmin_kpc=${RMIN_KPC}"
echo "rmax_kpc=${RMAX_KPC}"
echo "disk_height_kpc=${DISK_HEIGHT_KPC}"
echo "wind_radius_kpc=${WIND_RADIUS_KPC}"
echo "zmin_kpc=${ZMIN_KPC}"
echo "zmax_kpc=${ZMAX_KPC}"
echo "nbins=${NBINS}"
echo "sfr_window_myr=${SFR_WINDOW_MYR}"
echo "field_kind=${FIELD_KIND}"
echo "output_json_disk=${OUTPUT_JSON_DISK}"
echo "output_json_wind=${OUTPUT_JSON_WIND}"
echo "output_json_joint=${OUTPUT_JSON_JOINT}"

# One AMR-aware cylindrical-moments pass produces both the disk profile
# SFR(R) for |z| <= DISK_HEIGHT_KPC and the wind profile SFR(h) within
# WIND_RADIUS_KPC: cells are binned once by (r, |z|), and the enclosed
# profiles follow by cumulative summation.
"$PWD/scripts/utils/hpxrun_spack_hpx.sh" \
  -r srun \
  -p mpi \
  -l "$NNODES" \
  -t "$CPUS_PER_TASK" \
  "$PWD/.pixi/envs/spack-hpx/bin/python" \
  "$PWD/scripts/plotfile_enclosed_sfr.py" \
  -- \
  "$PLOTFILE" \
  --rmin-kpc "$RMIN_KPC" --rmax-kpc "$RMAX_KPC" \
  --disk-height-kpc "$DISK_HEIGHT_KPC" \
  --zmin-kpc "$ZMIN_KPC" --zmax-kpc "$ZMAX_KPC" \
  --wind-radius-kpc "$WIND_RADIUS_KPC" \
  --nbins "$NBINS" \
  --field-kind "$FIELD_KIND" \
  --sfr-window-myr "$SFR_WINDOW_MYR" \
  "${PROGRESS_ARGS[@]}" \
  --output-json "$OUTPUT_JSON_DISK" \
  --output-json-wind "$OUTPUT_JSON_WIND" \
  --output-json-joint "$OUTPUT_JSON_JOINT"

date
