#!/bin/bash
#SBATCH -t 00:05:00
#SBATCH -A ast236
#SBATCH -N 1
#SBATCH -p batch
#SBATCH -J kangaroo-projection
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32

set -euo pipefail

module load gcc/14.2.0

# Batch shells may not inherit the submitting shell's PATH.
if ! command -v spack >/dev/null 2>&1; then
  export PATH="${HOME}/spack/bin:${PATH}"
fi

if [[ $# -ne 1 ]]; then
  echo "Usage: sbatch $0 PLOTFILE" >&2
  exit 2
fi
PLOTFILE=$1
: "${OUTPUT_PNG:=p2_stellar_projection_yz_plane.png}"

SPACK_HPX_PREFIX="$(spack location -i 'hpx@1.11.0 networking=mpi %gcc@14.2.0')"
SPACK_MPI_PREFIX="$(spack location -i 'openmpi%gcc@14.2.0')"
export SPACK_HPX_PREFIX SPACK_MPI_PREFIX
export LD_LIBRARY_PATH="$SPACK_HPX_PREFIX/lib64:$SPACK_HPX_PREFIX/lib:$SPACK_MPI_PREFIX/lib64:$SPACK_MPI_PREFIX/lib:${LD_LIBRARY_PATH:-}"

date
echo "host=$(hostname)"
echo "SLURM_NNODES=${SLURM_NNODES}"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"
echo "SPACK_HPX_PREFIX=${SPACK_HPX_PREFIX}"
echo "SPACK_MPI_PREFIX=${SPACK_MPI_PREFIX}"

echo "plotfile: ${PLOTFILE}"

"$PWD/scripts/utils/hpxrun_spack_hpx.sh" \
  -r srun \
  -p mpi \
  -l "$SLURM_NNODES" \
  -t "$SLURM_CPUS_PER_TASK" \
  "$PWD/.pixi/envs/spack-hpx/bin/python" \
  "$PWD/scripts/plotfile_projection_cic_stellar.py" \
  -- \
  "${PLOTFILE}" \
  --particle-type StochasticStellarPop_particles \
  --zoom 100 \
  --resolution 1000,1000 \
  --output "$OUTPUT_PNG" \
  --axis-bounds="-3.086e22,3.086e22" \
  --axis x

date
