#!/bin/bash
#SBATCH -t 00:05:00
#SBATCH -A ast236
#SBATCH -N 1
#SBATCH -p batch
#SBATCH -J kangaroo-projection
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32

set -euo pipefail

# Slurm executes a spool copy, so prefer the checkout exported by the CLI.
REPO_ROOT="${KANGAROO_REPO_ROOT:-${SLURM_SUBMIT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}}"
source "$REPO_ROOT/batch/runtime.sh"

if [[ $# -ne 1 ]]; then
  echo "Usage: sbatch $0 PLOTFILE" >&2
  exit 2
fi
PLOTFILE=$1
kangaroo_setup_runtime
: "${OUTPUT_PNG:=p2_stellar_projection_yz_plane.png}"

date
echo "host=$(hostname)"
echo "NNODES=${NNODES}"
echo "CPUS_PER_TASK=${CPUS_PER_TASK}"
echo "KANGAROO_HPX_BACKEND=${KANGAROO_HPX_BACKEND}"
echo "KANGAROO_PYTHON=${KANGAROO_PYTHON}"

echo "plotfile: ${PLOTFILE}"

kangaroo_launch \
  "$REPO_ROOT/scripts/plotfile_projection_cic_stellar.py" \
  -- \
  "${PLOTFILE}" \
  --particle-type StochasticStellarPop_particles \
  --zoom 100 \
  --resolution 1000,1000 \
  --output "$OUTPUT_PNG" \
  --axis-bounds="-3.086e22,3.086e22" \
  --axis x

date
