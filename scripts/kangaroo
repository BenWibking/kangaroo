#!/usr/bin/env bash
# Repository entry point; ~/.local/bin/kangaroo forwards here.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
usage() {
  cat <<'HELP'
Usage: kangaroo jobs
       kangaroo COMMAND PLOTFILE [--campaign NAME] [--dry-run] [-- SBATCH_OPTIONS...]

List your pending/running Kangaroo jobs with "kangaroo jobs", or submit an
existing analysis batch job from this checkout.
Commands: toomre-q, enclosed-sfr, cylindrical-flux, cylindrical-radial-flux,
          spherical-flux, projection

Outputs: results/CAMPAIGN/PLOTFILE/ANALYSIS/
Set KANGAROO_CAMPAIGN to omit --campaign. Existing batch environment settings
(e.g. R_MAX_KPC, DISK_HEIGHT_KPC) still apply. Output locations are managed here.
Projection currently uses the stellar yz-map settings in make_projection.submit.

Examples:
  export KANGAROO_CAMPAIGN=noCGM_0.1uG_Phase0
  kangaroo toomre-q /path/to/plt000100
  kangaroo enclosed-sfr /path/to/plt000100 -- --time=01:00:00
  kangaroo cylindrical-flux /path/to/plt000100 --dry-run
HELP
}
fail() { echo "kangaroo: $*" >&2; exit 2; }
if [[ $# -eq 0 || "$1" == --help || "$1" == -h ]]; then usage; exit 0; fi
command_name=$1
shift
case "$command_name" in
  jobs)
    [[ $# -eq 0 ]] || fail 'usage: kangaroo jobs'
    # Fetch first so scheduler failures cannot look like an empty queue.
    queue=$(squeue --user="$(id -un)" --states=PENDING,RUNNING \
      --noheader --format='%i|%j|%T|%M|%D|%R|%o')
    awk -F '|' '
      BEGIN {
        printf "%-20s %-32s %-10s %-12s %-6s %s\n", \
          "JOBID", "NAME", "STATE", "ELAPSED", "NODES", "NODELIST(REASON)"
      }
      $2 ~ /^kangaroo-/ || \
      $7 ~ /\/kangaroo\/batch\/make_(toomre_q|enclosed_sfr|cylindrical_flux|cylindrical_radial_flux|spherical_flux|projection)\.submit([[:space:]]|$)/ {
        printf "%-20s %-32s %-10s %-12s %-6s %s\n", $1, $2, $3, $4, $5, $6
        count++
      }
      END { if (!count) print "No pending or running Kangaroo jobs." }
    ' <<< "$queue"
    exit 0 ;;
  toomre-q|enclosed-sfr|cylindrical-flux|cylindrical-radial-flux|spherical-flux|projection)
    analysis_name=${command_name//-/_} ;;
  *) fail "unknown command '$command_name' (see --help)" ;;
esac
[[ $# -gt 0 ]] || fail 'a plotfile directory is required'
[[ -d "$1" ]] || fail "plotfile directory does not exist: $1"
plotfile=$(cd "$1" && pwd -P)
plotfile_name=$(basename "$plotfile")
shift
campaign=${KANGAROO_CAMPAIGN:-}
dry_run=0
sbatch_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --campaign)
      [[ $# -ge 2 ]] || fail '--campaign requires a name'
      campaign=$2; shift 2 ;;
    --campaign=*) campaign=${1#*=}; shift ;;
    --dry-run) dry_run=1; shift ;;
    --) shift; sbatch_args=("$@"); break ;;
    *) fail "unknown option '$1'; put Slurm options after --" ;;
  esac
done
[[ "$campaign" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || fail 'set --campaign or KANGAROO_CAMPAIGN to a name using letters, digits, dots, underscores, and hyphens'
output_dir="$REPO_ROOT/results/$campaign/$plotfile_name/$analysis_name"
exports=()
case "$command_name" in
  toomre-q) exports+=("OUTPUT_DIR=$output_dir") ;;
  enclosed-sfr)
    exports+=("OUTPUT_JSON_DISK=$output_dir/enclosed_sfr_disk.json"
      "OUTPUT_JSON_WIND=$output_dir/enclosed_sfr_wind.json"
      "OUTPUT_JSON_JOINT=$output_dir/enclosed_sfr_joint.json") ;;
  cylindrical-flux) exports+=("OUTPUT_JSON=$output_dir/cylindrical_flux_surface.json") ;;
  cylindrical-radial-flux) exports+=("OUTPUT_JSON=$output_dir/cylindrical_radial_flux.json") ;;
  spherical-flux) exports+=("OUTPUT_JSON=$output_dir/flux_surface.json") ;;
  projection) exports+=("OUTPUT_PNG=$output_dir/stellar_projection_yz.png") ;;
esac
batch_script="$REPO_ROOT/batch/make_${analysis_name}.submit"
args=(sbatch "${sbatch_args[@]}" --export=ALL --chdir="$REPO_ROOT"
  --output="$output_dir/slurm-%j.out" "$batch_script" "$plotfile")
if [[ "$dry_run" == 1 ]]; then
  printf '%q ' env "${exports[@]}" "${args[@]}"
  printf '\n'
  exit 0
fi
mkdir -p "$output_dir"
cd "$REPO_ROOT"
exec env "${exports[@]}" "${args[@]}"
